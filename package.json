{
  "name": "@rhberro/oxsome",
  "version": "0.1.1",
  "description": "Custom oxlint plugin (4 opinionated rules) plus a shared oxfmt config.",
  "keywords": [
    "config",
    "eslint-plugin",
    "oxc",
    "oxfmt",
    "oxlint",
    "oxlint-plugin",
    "shareable-config"
  ],
  "homepage": "https://github.com/rhberro/oxsome#readme",
  "bugs": {
    "url": "https://github.com/rhberro/oxsome/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhberro/oxsome.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "prelint": "npm run build",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "npm run build && npm run lint && npm run format:check",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.86.0"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^7.0.2"
  }
}
