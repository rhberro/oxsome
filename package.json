{
  "name": "@rhberro/oxsome",
  "version": "0.1.0",
  "description": "Custom oxlint plugin (4 opinionated rules) plus a shared oxfmt config.",
  "keywords": [
    "config",
    "eslint-plugin",
    "oxc",
    "oxfmt",
    "oxlint",
    "oxlint-plugin",
    "shareable-config"
  ],
  "homepage": "https://github.com/rhberro/oxsome#readme",
  "bugs": {
    "url": "https://github.com/rhberro/oxsome/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhberro/oxsome.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./plugin": {
      "types": "./src/index.d.ts",
      "default": "./src/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc",
    "prepublishOnly": "npm run typecheck"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.86.0"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxlint": ">=1.86.0"
  }
}
