{
  "lsp": {
    "oxfmt": {
      "initialization_options": {
        "settings": {
          "run": "onSave"
        }
      }
    }
  },
  "languages": {
    "JavaScript": {
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "code_action": "source.fixAll.oxc"
        },
        {
          "language_server": { "name": "oxfmt" }
        }
      ],
      "code_actions_on_format": {
        "source.fixAll.oxc": true
      },
      "format_on_save": "on"
    },
